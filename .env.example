# Скопируйте этот файл в .env (или .env.local) и заполните значения:
#   cp .env.example .env
# Файлы .env* в git не попадают. Сервер читает сначала .env.local, затем .env.

# --- Доступ в админку (/login, /admin) ---
# Логин администратора
ADMIN_LOGIN=admin
# Пароль администратора. ОБЯЗАТЕЛЬНО замените на длинный и уникальный.
ADMIN_PASSWORD=change-me

# --- Безопасность ---
# Секрет для подписи сессии админа. Длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# После смены все админы будут разлогинены.
JWT_SECRET=change-me-to-long-random-string
# true — cookie сессии отдаётся только по https. Включите на проде за https.
COOKIE_SECURE=false

# --- Сервер ---
# Порт Node-сервера. Nginx проксирует на 127.0.0.1:<PORT>.
PORT=3001

# --- Розыгрыш ---
# false — один человек (по телефону) выигрывает только один приз;
# true  — исключается лишь уже выигравший билет, у человека могут быть несколько призов.
ALLOW_MULTIPLE_WINS=false
# Через сколько секунд после нажатия «Разыграть» берётся раунд случайности drand (минимум 6).
DRAW_DELAY_SECONDS=15
